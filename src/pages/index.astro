---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const allGames = await getAllGames(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const categories = Array.from(
  new Map(
    allGames
      .filter((game) => game.category)
      .map((game) => [game.category!.id, game.category!]),
  ).values(),
).sort((left, right) => left.name.localeCompare(right.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-4 shadow-lg">
      <div class="grid gap-4 md:grid-cols-3" data-testid="game-filters">
        <div>
          <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">
            Filter by category
          </label>
          <select
            id="category-filter"
            data-testid="category-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All categories</option>
            {categories.map((category) => (
              <option value={String(category.id)}>{category.name}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">
            Filter by publisher
          </label>
          <select
            id="publisher-filter"
            data-testid="publisher-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={String(publisher.id)}>{publisher.name}</option>
            ))}
          </select>
        </div>

        <div class="flex items-end">
          <button
            type="button"
            data-testid="clear-filters-button"
            class="inline-flex w-full items-center justify-center rounded-lg border border-slate-600 bg-slate-700 px-3 py-2 text-sm font-medium text-slate-100 transition-colors hover:bg-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            Clear filters
          </button>
        </div>
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {allGames.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {allGames.map((game) => <GameCard game={game} />)}
          </div>
          <div
            class="mt-6 hidden rounded-xl border border-slate-700 bg-slate-800/60 p-4 text-slate-300"
            data-testid="games-empty-state"
          >
            No games match the selected filters.
          </div>
        </>
      )}
    </div>
  </div>

  <script>
    const categoryFilter = document.querySelector('[data-testid="category-filter"]');
    const publisherFilter = document.querySelector('[data-testid="publisher-filter"]');
    const clearFiltersButton = document.querySelector('[data-testid="clear-filters-button"]');
    const emptyState = document.querySelector('[data-testid="games-empty-state"]');
    const cards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));

    function applyFilters() {
      const selectedCategory = categoryFilter?.value ?? '';
      const selectedPublisher = publisherFilter?.value ?? '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const matchesCategory = !selectedCategory || card.getAttribute('data-category-id') === selectedCategory;
        const matchesPublisher = !selectedPublisher || card.getAttribute('data-publisher-id') === selectedPublisher;
        const isVisible = matchesCategory && matchesPublisher;

        card.style.display = isVisible ? '' : 'none';

        if (isVisible) {
          visibleCount += 1;
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
    }

    categoryFilter?.addEventListener('change', applyFilters);
    publisherFilter?.addEventListener('change', applyFilters);
    clearFiltersButton?.addEventListener('click', () => {
      if (categoryFilter) {
        categoryFilter.value = '';
      }
      if (publisherFilter) {
        publisherFilter.value = '';
      }
      applyFilters();
    });

    applyFilters();
  </script>
</Layout>
